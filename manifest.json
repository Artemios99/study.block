{
  "manifest_version": 3,
  "name": "Study Blocker",
  "version": "1.0",
  "description": "Blocks distracting websites during your study sessions.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}